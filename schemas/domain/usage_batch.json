{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UsageBatch",
  "type": "object",
  "required": [
    "batch_id",
    "events"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UsageEvent"
      }
    }
  },
  "definitions": {
    "Confidence": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "UsageEvent": {
      "type": "object",
      "required": [
        "confidence",
        "cost",
        "data_source",
        "id",
        "model",
        "provider_id",
        "timestamp",
        "tokens_input",
        "tokens_output"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/definitions/Confidence"
        },
        "cost": {
          "type": "string"
        },
        "data_source": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "project_hash": {
          "description": "Keyed hash of the source's raw project/folder identifier. `None` when the source does not expose a project. The raw path is never persisted.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "provider_id": {
          "type": "string"
        },
        "session_hash": {
          "description": "Keyed hash of the source's raw session identifier. `None` when the source does not expose a session. Raw identifiers never leave the adapter; only the hash is persisted.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "tokens_cache_write": {
          "description": "Input tokens written into the provider cache, when the source exposes that breakdown.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_cached": {
          "description": "Non-cached input tokens. Cached input is kept separately so totals and pricing never double-count the same prompt bytes.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_input": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_reasoning": {
          "description": "Reasoning tokens are a provider-reported subset of output tokens.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}